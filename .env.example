# Site Configuration
NEXT_PUBLIC_SITE_URL=https://eventforcesa.netlify.app
NEXT_PUBLIC_SITE_NAME=Event Force

# API Configuration
NEXT_PUBLIC_API_URL=https://api.eventforce.sa.com
API_BASE_URL=https://api.eventforce.sa.com

# Database Configuration (if applicable)
DATABASE_URL=postgresql://user:password@localhost:5432/eventforce
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=eventforce
DATABASE_USER=user
DATABASE_PASSWORD=password

# Authentication & Security
NEXTAUTH_URL=https://eventforcesa.netlify.app
NEXTAUTH_SECRET=your-nextauth-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here-change-in-production

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@eventforce.sa.com
SMTP_FROM_NAME=Event Force

# Social Media API Keys (if needed for integrations)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Analytics & Tracking
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# Payment Gateway (if applicable)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# File Upload & Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eventforce-uploads

# Contact Information
CONTACT_EMAIL=Reservations@eventforce.sa.com
CONTACT_PHONE=+966594279012
CONTACT_ADDRESS=Saudi Arabia

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Environment
NODE_ENV=development